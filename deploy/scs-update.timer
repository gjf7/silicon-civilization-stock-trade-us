[Unit]
Description=Check for a new stock dashboard release

[Timer]
# Every 5 minutes. GitHub Actions needs a few minutes to publish an image
# after a push, so the first tick usually reports "not published yet".
OnBootSec=3min
OnUnitActiveSec=5min
# Catch up if the host was asleep at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
